# =====================================================================
# SYSTEM: Dagwood Sovereign Mesh
# COMPONENT: dagwood_stack.env.example
# VECTOR: [St] Storage
# DESCRIPTION: Vault configuration template. Copy to .dagwood_vault/
#              dagwood_stack.env and populate with real credentials.
#              This file NEVER contains real values and is safe to commit.
#
# SECURITY POLICY:
#   - The real .env file must NEVER be committed to version control
#   - Add .dagwood_vault/ to .gitignore
#   - Keys are injected into the mediator container read-only at runtime
#
# CHANGELOG:
#   v1.0 - Initial template
# VALIDATION: STAGE_3_PRODUCTION
# =====================================================================

# =====================================================================
# [Lo] HOST: Primary LLM Router (Default Fallback)
# [Lo] Policy: Routes all unmatched model requests
# [Lo] Status: REQUIRED - system fails without this key
# =====================================================================
OR_PRIMARY_ANCHOR_API_KEY=sk-or-v1-{{YOUR_OPENROUTER_API_KEY_HERE}}

# =====================================================================
# [Lo] HOST: High-Throughput Logic Node
# [Lo] Policy: Routes requests matching alias "{{ALIAS_LOGIC}}"
# [Lo] Status: OPTIONAL
# =====================================================================
SN_LOGIC_DEEPSEEK_API_KEY={{YOUR_SAMBANOVA_API_KEY_HERE}}

# =====================================================================
# [Lo] HOST: Ultra-Low Latency Reflex Node
# [Lo] Policy: Routes requests matching alias "{{ALIAS_REFLEX}}"
# [Lo] Status: OPTIONAL
# =====================================================================
GR_SPEED_REFLEX_API_KEY={{YOUR_GROQ_API_KEY_HERE}}

# =====================================================================
# [Lo] HOST: Bulk Ingestion Vector Node
# [Lo] Policy: Routes requests matching alias "{{ALIAS_BULK}}"
# [Lo] Status: OPTIONAL
# =====================================================================
CR_BULK_INGEST_API_KEY={{YOUR_CEREBRAS_API_KEY_HERE}}

# =====================================================================
# [η] Add additional provider keys following this pattern:
# <PREFIX>_<ALIAS>_API_KEY=<value>
# Then add a corresponding entry to ROUTING_TABLE in dagwood_mediator.py
# =====================================================================
